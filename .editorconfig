# Use the same encoding, indentation and line endings across editors and operating systems.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces can represent an intentional Markdown line break.
trim_trailing_whitespace = false
